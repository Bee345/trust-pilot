# -------------------------------
# 1. Server configuration
# -------------------------------
# The port on which the Express server will listen.
PORT=3000

# -------------------------------
# 2. Supabase configuration
# -------------------------------
# Base URL of your Supabase project (found in the Supabase dashboard → Settings → API).
SUPABASE_URL=your-supabase-url
# Service role key – full‑access key used by the backend to bypass RLS.
SUPABASE_KEY=your-supabase-service-role-key
# Direct PostgreSQL connection string (replace with your actual password).
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# -------------------------------
# 3. Authentication
# -------------------------------
# Secret used to sign and verify JWT tokens.
JWT_SECRET=your-jwt-secret

# -------------------------------
# 4. SMS (Twilio)
# -------------------------------
# Twilio Account SID – identifies your Twilio account.
TWILIO_SID=your-twilio-sid
# Twilio Auth Token – used to authenticate API requests.
TWILIO_TOKEN=your-twilio-token
# Phone number (in E.164 format) from which OTP SMS will be sent.
TWILIO_PHONE=+1234567890

# -------------------------------
# 5. Payments (Paystack)
# -------------------------------
# Secret key for server‑side Paystack API calls.
PAYSTACK_SECRET=your-paystack-secret

# -------------------------------
# 6. Realtime (Socket.io)
# -------------------------------
# Port on which the Socket.io server will run (can be same as Express or separate).
SOCKET_PORT=3001

# -------------------------------
# 7. CORS / Frontend URL
# -------------------------------
# Comma-separated list of allowed frontend origins.
ALLOWED_ORIGINS=http://localhost:5173
# Base URL of the frontend (used in Paystack callback_url and Socket.io CORS).
FRONTEND_URL=http://localhost:5173

# -------------------------------
# 8. Error tracking (Sentry)
# -------------------------------
# DSN for the backend Sentry project (Node.js).
SENTRY_DSN=your-sentry-dsn
